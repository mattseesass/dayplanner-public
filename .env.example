# Copy this file to .env.local and fill it in. Never commit .env.local, and never paste these values
# into a chat, an issue or a screenshot. Everything here is a secret except the project URL.

# --- Supabase (your own free project: https://supabase.com) ---
# Project Settings -> Data API -> Project URL (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> the secret / service_role key. Full access to your database,
# used only on the server. If it ever leaks, rotate it in Supabase.
SUPABASE_SERVICE_ROLE_KEY=
# "Connect" button -> Session pooler -> the postgresql://... string, with your database password filled in.
# Only used on your computer by `npm run db:migrate` to create the tables. Not needed on Vercel.
SUPABASE_DB_URL=

# --- The app itself ---
# The passcode you type to open the app. Pick something long. It is the only thing protecting your data.
APP_PASSCODE=
# A long random string used to sign the login cookie (required). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Optional: the Brain connector (lets an AI assistant save tasks and notes through /api/mcp) ---
# Any long random string. Leave it empty if you won't use the connector. Generate it the same way as above.
BRAIN_TOKEN=
